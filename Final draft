def draw_swing_door(x, y, size=60, orientation="top-right"):
    """Draws an architectural swing door with door leaf and swing clearance arc."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_size = to_screen_dim(size)

    # Horizontal Wall Doors
    if orientation == "top-right":
        go_to(sx + s_size, sy)
        turtle.setheading(90)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(90)
        turtle.forward(s_size)

    elif orientation == "top-left":
        go_to(sx, sy + s_size)
        turtle.setheading(180)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(90)
        turtle.forward(s_size)

    elif orientation == "bottom-right":
        go_to(sx, sy - s_size)
        turtle.setheading(0)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(270)
        turtle.forward(s_size)

    elif orientation == "bottom-left":
        go_to(sx - s_size, sy)
        turtle.setheading(270)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(270)
        turtle.forward(s_size)

    # Vertical Wall Doors (horizontal door leaf)
    elif orientation == "right-top":
        go_to(sx, sy + s_size)
        turtle.setheading(270)
        turtle.circle(-s_size, 90)
        go_to(sx, sy)
        turtle.setheading(0)
        turtle.forward(s_size)

    elif orientation == "right-bottom":
        go_to(sx, sy - s_size)
        turtle.setheading(90)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(0)
        turtle.forward(s_size)

    elif orientation == "left-top":
        go_to(sx, sy + s_size)
        turtle.setheading(270)
        turtle.circle(s_size, 90)
        go_to(sx, sy)
        turtle.setheading(180)
        turtle.forward(s_size)

    elif orientation == "left-bottom":
        go_to(sx, sy - s_size)
        turtle.setheading(90)
        turtle.circle(-s_size, 90)
        go_to(sx, sy)
        turtle.setheading(180)
        turtle.forward(s_size)


def draw_sliding_door(x, y, length=100, orientation="horizontal", gap=6):
    """Draws a sliding door with overlapping panels and jambs."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_gap = to_screen_dim(gap)
    panel_len = s_len * 0.55

    if orientation == "horizontal":
        go_to(sx, sy + s_gap / 2)
        turtle.setheading(0)
        turtle.forward(panel_len)
        go_to(sx + s_len - panel_len, sy - s_gap / 2)
        turtle.setheading(0)
        turtle.forward(panel_len)
        go_to(sx, sy - s_gap)
        turtle.setheading(90)
        turtle.forward(2 * s_gap)
        go_to(sx + s_len, sy - s_gap)
        turtle.setheading(90)
        turtle.forward(2 * s_gap)
    else:
        go_to(sx - s_gap / 2, sy)
        turtle.setheading(90)
        turtle.forward(panel_len)
        go_to(sx + s_gap / 2, sy + s_len - panel_len)
        turtle.setheading(90)
        turtle.forward(panel_len)
        go_to(sx - s_gap, sy)
        turtle.setheading(0)
        turtle.forward(2 * s_gap)
        go_to(sx - s_gap, sy + s_len)
        turtle.setheading(0)
        turtle.forward(2 * s_gap)


def draw_standard_window(x, y, length=120, orientation="horizontal", thickness=14):
    """Draws a standard architectural window (frame with center glass line and jambs)."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_thick = to_screen_dim(thickness)

    if orientation == "horizontal":
        go_to(sx, sy + s_thick / 2)
        turtle.setheading(0)
        turtle.forward(s_len)
        go_to(sx, sy - s_thick / 2)
        turtle.setheading(0)
        turtle.forward(s_len)
        go_to(sx, sy)
        turtle.setheading(0)
        turtle.forward(s_len)
        go_to(sx, sy - s_thick / 2)
        turtle.setheading(90)
        turtle.forward(s_thick)
        go_to(sx + s_len, sy - s_thick / 2)
        turtle.setheading(90)
        turtle.forward(s_thick)
    else:
        go_to(sx - s_thick / 2, sy)
        turtle.setheading(90)
        turtle.forward(s_len)
        go_to(sx + s_thick / 2, sy)
        turtle.setheading(90)
        turtle.forward(s_len)
        go_to(sx, sy)
        turtle.setheading(90)
        turtle.forward(s_len)
        go_to(sx - s_thick / 2, sy)
        turtle.setheading(0)
        turtle.forward(s_thick)
        go_to(sx - s_thick / 2, sy + s_len)
        turtle.setheading(0)
        turtle.forward(s_thick)


def draw_sliding_window(x, y, length=120, orientation="horizontal", thickness=14):
    """Draws a sliding window (outer frame with offset sliding sashes)."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_thick = to_screen_dim(thickness)
    panel_len = s_len * 0.55
    offset = to_screen_dim(3)

    if orientation == "horizontal":
        go_to(sx, sy - s_thick / 2)
        turtle.setheading(0)
        for _ in range(2):
            turtle.forward(s_len)
            turtle.left(90)
            turtle.forward(s_thick)
            turtle.left(90)
        go_to(sx, sy + offset)
        turtle.setheading(0)
        turtle.forward(panel_len)
        go_to(sx + s_len - panel_len, sy - offset)
        turtle.setheading(0)
        turtle.forward(panel_len)
    else:
        go_to(sx - s_thick / 2, sy)
        turtle.setheading(0)
        for _ in range(2):
            turtle.forward(s_thick)
            turtle.left(90)
            turtle.forward(s_len)
            turtle.left(90)
        go_to(sx - offset, sy)
        turtle.setheading(90)
        turtle.forward(panel_len)
        go_to(sx + offset, sy + s_len - panel_len)
        turtle.setheading(90)
        turtle.forward(panel_len)


