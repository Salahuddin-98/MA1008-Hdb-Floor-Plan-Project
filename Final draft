def draw_rect(x, y, width, height):
    """Helper to draw an outlined rectangle from bottom-left corner."""
    go_to(x, y)
    turtle.setheading(0)
    for _ in range(2):
        turtle.forward(width)
        turtle.left(90)
        turtle.forward(height)
        turtle.left(90)


def draw_bed(x, y, bed_type="queen", orientation="vertical"):
    
    #Draws an architectural bed with pillows:
##    - Dimensions scaled down by 0.75 (75% of original baseline):
##        Queen: 112.5 x 142.5 (originally 150 x 190)
##        Single: 67.5 x 135.0 (originally 90 x 180)
##    - orientation:
##        'vertical'   : Headboard at the top (+Y), foot at bottom (-Y)
##        'horizontal' : Headboard at the left (-X), foot at right (+X)
    
    
    if bed_type.lower().startswith('s'):
        bed_w = 90 * 0.75   # 67.5
        bed_l = 180 * 0.75  # 135.0
        num_pillows = 1
        bed_label = "Single"
    else:
        bed_w = 150 * 0.75  # 112.5
        bed_l = 190 * 0.75  # 142.5
        num_pillows = 2
        bed_label = "Queen"

    sx = to_screen_x(x)
    sy = to_screen_y(y)
    sw = to_screen_dim(bed_w)
    sl = to_screen_dim(bed_l)

    turtle.pensize(1)
    turtle.pencolor("#333333")

    if orientation == "vertical":
        # Mattress outline (origin is top-left of the bed)
        draw_rect(sx, sy - sl, sw, sl)

        # Headboard fold line (25% from top)
        go_to(sx, sy - sl * 0.25)
        turtle.setheading(0)
        turtle.forward(sw)

        # Draw Pillow(s) near headboard (top)
        pillow_h = sl * 0.18
        if num_pillows == 1:
            pillow_w = sw * 0.60
            px = sx + (sw - pillow_w) / 2
            py = sy - sl * 0.22
            draw_rect(px, py, pillow_w, pillow_h)
        else:
            pillow_w = sw * 0.40
            gap = sw * 0.06
            px1 = sx + gap
            py1 = sy - sl * 0.22
            draw_rect(px1, py1, pillow_w, pillow_h)

            px2 = sx + sw - gap - pillow_w
            draw_rect(px2, py1, pillow_w, pillow_h)

    else:  # horizontal (headboard at the left)
        draw_rect(sx, sy, sl, sw)

        # Headboard fold line (25% from left)
        go_to(sx + sl * 0.25, sy)
        turtle.setheading(90)
        turtle.forward(sw)

        # Draw Pillow(s) near headboard (left)
        pillow_w = sl * 0.18
        if num_pillows == 1:
            pillow_h = sw * 0.60
            px = sx + sl * 0.04
            py = sy + (sw - pillow_h) / 2
            draw_rect(px, py, pillow_w, pillow_h)
        else:
            pillow_h = sw * 0.40
            gap = sw * 0.06
            px = sx + sl * 0.04
            py1 = sy + gap
            draw_rect(px, py1, pillow_w, pillow_h)

            py2 = sy + sw - gap - pillow_h
            draw_rect(px, py2, pillow_w, pillow_h)

    turtle.pencolor("black")


def draw_wardrobe(x, y, length, depth=60, orientation="horizontal"):
  
    #Draws an architectural wardrobe:

    sx = to_screen_x(x)
    sy = to_screen_y(y)
    slen = to_screen_dim(length)
    sdepth = to_screen_dim(depth)

    turtle.pensize(1)
    turtle.pencolor("#2B2B2B")

    if orientation == "horizontal":
        # Outer cabinet rectangle
        draw_rect(sx, sy, slen, sdepth)
        # Center divider line
        go_to(sx + slen / 2, sy)
        turtle.setheading(90)
        turtle.forward(sdepth)
        # Hanger rail across center
        go_to(sx + slen * 0.05, sy + sdepth / 2)
        turtle.setheading(0)
        turtle.forward(slen * 0.90)
    else:  # vertical
        draw_rect(sx, sy, sdepth, slen)
        # Center divider line
        go_to(sx, sy + slen / 2)
        turtle.setheading(0)
        turtle.forward(sdepth)
        # Hanger rail across center
        go_to(sx + sdepth / 2, sy + slen * 0.05)
        turtle.setheading(90)
        turtle.forward(slen * 0.90)

    turtle.pencolor("black")


