def handle_set_scale():
    global PLAN_SCALE
    screen = turtle.Screen()
    val = screen.numinput("Scale Setting", "Enter scale factor (e.g., 0.5, 0.8, 1.0):",
                          default=PLAN_SCALE, minval=0.1, maxval=3.0)
    if val is not None and val > 0:
        PLAN_SCALE = val
        turtle.clear()
        render_gui()
        render_canvas_frame()
        # Redraw all elements with the new scale
        turtle.tracer(0)
        for elem in PLAN_ELEMENTS:
            cmd = elem[0]
            if cmd == "NON_STRUCTURAL_WALL":
                draw_non_structural_wall(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "STRUCTURAL_WALL":
                draw_structural_wall(elem[1], elem[2], elem[3], 16, elem[4])
            elif cmd == "GABLE_END_WALL":
                draw_gable_end_wall(elem[1], elem[2], elem[3], 20, elem[4])
            elif cmd == "SWING_DOOR":
                draw_swing_door(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "SLIDING_DOOR":
                draw_sliding_door(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "STANDARD_WINDOW":
                draw_standard_window(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "SLIDING_WINDOW":
                draw_sliding_window(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "BED":
                draw_bed(elem[1], elem[2], elem[3], elem[4])
            elif cmd == "WARDROBE":
                draw_wardrobe(elem[1], elem[2], elem[3], elem[4], elem[5])
        turtle.tracer(1)


