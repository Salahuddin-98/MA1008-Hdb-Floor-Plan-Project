import turtle

# ==========================================
# GLOBAL CONFIGURATION & STATE
# ==========================================
PLAN_SCALE = 0.5
ORIGIN_X = 0
ORIGIN_Y = -60

# Stores all placed elements:
# Format: [TYPE, param1, param2, ...]
PLAN_ELEMENTS = []


# ==========================================
# 1. COORDINATE CONVERSION & PEN HELPERS
# ==========================================

def go_to(x, y):
    """Moves turtle to (x, y) without drawing."""
    turtle.penup()
    turtle.goto(x, y)
    turtle.pendown()


def to_screen_x(user_x):
    """Converts user X coordinate to scaled screen X coordinate."""
    return ORIGIN_X + (user_x * PLAN_SCALE)


def to_screen_y(user_y):
    """Converts user Y coordinate to scaled screen Y coordinate."""
    return ORIGIN_Y + (user_y * PLAN_SCALE)


def to_screen_dim(dim):
    """Scales a dimension by the active plan scale factor."""
    return dim * PLAN_SCALE


# ==========================================
# 2. CANVAS FRAME & BOUNDING BOX
# ==========================================

def draw_perimeter_box():
    """Draws the floor plan canvas bounding box below the toolbar."""
    go_to(-475, -340)
    turtle.pencolor("#708090")  # Slate gray
    turtle.pensize(2)
    turtle.setheading(0)
    for _ in range(2):
        turtle.forward(950)
        turtle.left(90)
        turtle.forward(520)
        turtle.left(90)

    # Scale status display badge
    go_to(340, 162)
    turtle.pencolor("#555555")
    turtle.write(f"Scale: {PLAN_SCALE:.1f}x", font=("Arial", 10, "bold"))
    turtle.pencolor("black")
    turtle.pensize(1)


def render_canvas_frame():
    """Renders the bounding canvas border."""
    turtle.tracer(0)
    draw_perimeter_box()
    turtle.tracer(1)


# ==========================================
# 3. WALL DRAWING FUNCTIONS
# ==========================================

def draw_non_structural_wall(x, y, length, orientation='horizontal', thickness=6):
    """Draws a non-structural wall (pair of parallel thin lines)."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_thick = to_screen_dim(thickness)

    if orientation == 'horizontal':
        go_to(sx, sy + s_thick / 2)
        turtle.setheading(0)
        turtle.forward(s_len)
        go_to(sx, sy - s_thick / 2)
        turtle.setheading(0)
        turtle.forward(s_len)
    elif orientation == 'vertical':
        go_to(sx + s_thick / 2, sy)
        turtle.setheading(90)
        turtle.forward(s_len)
        go_to(sx - s_thick / 2, sy)
        turtle.setheading(90)
        turtle.forward(s_len)


def draw_structural_wall(x, y, length, thickness=16, orientation='horizontal'):
    #Draws a structural wall (solid black filled rectangular bar)
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_thick = to_screen_dim(thickness)

    go_to(sx, sy)
    turtle.fillcolor("black")
    turtle.begin_fill()
    if orientation == 'horizontal':
        turtle.setheading(0)
        for _ in range(2):
            turtle.forward(s_len)
            turtle.left(90)
            turtle.forward(s_thick)
            turtle.left(90)
    elif orientation == 'vertical':
        turtle.setheading(90)
        for _ in range(2):
            turtle.forward(s_len)
            turtle.right(90)
            turtle.forward(s_thick)
            turtle.right(90)
    turtle.end_fill()


def draw_gable_end_wall(x, y, length, thickness=20, orientation='horizontal', inset=3):
    """Draws a gable-end wall (nested cavity rectangle)."""
    sx = to_screen_x(x)
    sy = to_screen_y(y)
    s_len = to_screen_dim(length)
    s_thick = to_screen_dim(thickness)
    s_inset = to_screen_dim(inset)

    if orientation == 'horizontal':
        w, h = s_len, s_thick
    else:
        w, h = s_thick, s_len

    go_to(sx, sy)
    turtle.setheading(0)
    for _ in range(2):
        turtle.forward(w)
        turtle.left(90)
        turtle.forward(h)
        turtle.left(90)

    go_to(sx + s_inset, sy + s_inset)
    for _ in range(2):
        turtle.forward(w - 2 * s_inset)
        turtle.left(90)
        turtle.forward(h - 2 * s_inset)
        turtle.left(90)


