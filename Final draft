def prompt_opening_inputs(title, default_len=100):
    """Prompts for starting coordinates, length, and orientation."""
    screen = turtle.Screen()
    x = screen.numinput(title, "Start X (-400 to 400):", default=0, minval=-500, maxval=500)
    if x is None:
        return None
    y = screen.numinput(title, "Start Y (-300 to 150):", default=0, minval=-400, maxval=200)
    if y is None:
        return None
    length = screen.numinput(title, "Length (pixels):", default=default_len, minval=20, maxval=600)
    if length is None:
        return None
    ori = screen.textinput(title, "Orientation ('h' for horizontal, 'v' for vertical):")
    if ori is None or ori.lower().startswith('h'):
        orientation = 'horizontal'
    else:
        orientation = 'vertical'
    return x, y, length, orientation


def prompt_swing_door_inputs():
    """Prompts for swing door hinge position, size, and swing direction."""
    screen = turtle.Screen()
    x = screen.numinput("Swing Door", "Hinge X coordinate:", default=0, minval=-500, maxval=500)
    if x is None:
        return None
    y = screen.numinput("Swing Door", "Hinge Y coordinate:", default=0, minval=-400, maxval=200)
    if y is None:
        return None
    size = screen.numinput("Swing Door", "Door width (radius):", default=60, minval=20, maxval=200)
    if size is None:
        return None

    prompt_text = (
        "Swing Direction:\n"
        "1: Top-Right   2: Top-Left\n"
        "3: Bottom-Right 4: Bottom-Left\n"
        "5: Right-Top    6: Right-Bottom\n"
        "7: Left-Top     8: Left-Bottom"
    )
    choice = screen.textinput("Swing Door", prompt_text)
    mapping = {
        '1': 'top-right', '2': 'top-left', '3': 'bottom-right', '4': 'bottom-left',
        '5': 'right-top', '6': 'right-bottom', '7': 'left-top', '8': 'left-bottom'
    }
    orientation = mapping.get(choice, 'top-right')
    return x, y, size, orientation


def prompt_bed_inputs():
    """Prompts for Bed type, position, and orientation."""
    screen = turtle.Screen()
    choice = screen.textinput("Place Bed", "Select Bed Size:\n1: Queen Bed (2 pillows)\n2: Single Bed (1 pillow)")
    if choice is None:
        return None
    bed_type = "single" if choice.strip() == '2' else "queen"

    x = screen.numinput("Place Bed", "Position X (-400 to 400):", default=0, minval=-500, maxval=500)
    if x is None:
        return None
    y = screen.numinput("Place Bed", "Position Y (-300 to 150):", default=0, minval=-400, maxval=200)
    if y is None:
        return None

    ori_input = screen.textinput("Place Bed", "Orientation ('v' for vertical, 'h' for horizontal):")
    orientation = "horizontal" if (ori_input and ori_input.lower().startswith('h')) else "vertical"

    return x, y, bed_type, orientation


