# 6. TEXT FILE PERSISTENCE (SAVE / LOAD)
# ==========================================

def save_plan_to_file(filename):
    """Saves the current floor plan elements to a text file."""
    try:
        if not filename.endswith('.txt'):
            filename = filename + '.txt'
        with open(filename, 'w') as file:
            file.write("# MA1008 BTO Floor Plan Data File\n")
            file.write(f"SCALE,{PLAN_SCALE}\n")
            for elem in PLAN_ELEMENTS:
                line = ",".join(str(item) for item in elem)
                file.write(line + "\n")
        print(f"[SUCCESS] Saved {len(PLAN_ELEMENTS)} elements to {filename}")
        return True
    except IOError as e:
        print(f"[ERROR] Failed to save file {filename}: {e}")
        return False


def load_plan_from_file(filename):
    """Loads a floor plan from a text file and draws all elements."""
    global PLAN_SCALE, PLAN_ELEMENTS

    if not filename.endswith('.txt'):
        filename = filename + '.txt'

    try:
        with open(filename, 'r') as file:
            lines = file.readlines()
    except FileNotFoundError:
        print(f"\n[ERROR] File Not Found: '{filename}' does not exist.")
        print("Please verify the file name and ensure it is located in the working directory.\n")
        return False
    except IOError as e:
        print(f"[ERROR] Could not read file '{filename}': {e}")
        return False

    # Clean existing canvas
    turtle.clear()
    PLAN_ELEMENTS = []
    render_gui()

    new_scale = PLAN_SCALE
    turtle.tracer(0)

    for line in lines:
        line = line.strip()
        if not line or line.startswith('#'):
            continue

        parts = [p.strip() for p in line.split(',')]
        cmd = parts[0].upper()

        try:
            if cmd == "SCALE" and len(parts) >= 2:
                new_scale = float(parts[1])
                PLAN_SCALE = new_scale
            elif cmd == "NON_STRUCTURAL_WALL" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_non_structural_wall(x, y, length, ori)
                PLAN_ELEMENTS.append(["NON_STRUCTURAL_WALL", x, y, length, ori])
            elif cmd == "STRUCTURAL_WALL" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_structural_wall(x, y, length, 16, ori)
                PLAN_ELEMENTS.append(["STRUCTURAL_WALL", x, y, length, ori])
            elif cmd == "GABLE_END_WALL" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_gable_end_wall(x, y, length, 20, ori)
                PLAN_ELEMENTS.append(["GABLE_END_WALL", x, y, length, ori])
            elif cmd == "SWING_DOOR" and len(parts) >= 5:
                x, y, size, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_swing_door(x, y, size, ori)
                PLAN_ELEMENTS.append(["SWING_DOOR", x, y, size, ori])
            elif cmd == "SLIDING_DOOR" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_sliding_door(x, y, length, ori)
                PLAN_ELEMENTS.append(["SLIDING_DOOR", x, y, length, ori])
            elif cmd == "STANDARD_WINDOW" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_standard_window(x, y, length, ori)
                PLAN_ELEMENTS.append(["STANDARD_WINDOW", x, y, length, ori])
            elif cmd == "SLIDING_WINDOW" and len(parts) >= 5:
                x, y, length, ori = float(parts[1]), float(parts[2]), float(parts[3]), parts[4]
                draw_sliding_window(x, y, length, ori)
                PLAN_ELEMENTS.append(["SLIDING_WINDOW", x, y, length, ori])
            elif cmd == "BED" and len(parts) >= 5:
                x, y, btype, ori = float(parts[1]), float(parts[2]), parts[3], parts[4]
                draw_bed(x, y, btype, ori)
                PLAN_ELEMENTS.append(["BED", x, y, btype, ori])
            elif cmd == "WARDROBE" and len(parts) >= 6:
                x, y, wlen, wdepth, ori = float(parts[1]), float(parts[2]), float(parts[3]), float(parts[4]), parts[5]
                draw_wardrobe(x, y, wlen, wdepth, ori)
                PLAN_ELEMENTS.append(["WARDROBE", x, y, wlen, wdepth, ori])
        except (ValueError, IndexError) as err:
            print(f"[WARNING] Skipping malformed line '{line}': {err}")

    # Redraw frame with active scale
    draw_perimeter_box()
    turtle.tracer(1)
    print(f"[SUCCESS] Loaded {len(PLAN_ELEMENTS)} features from '{filename}'.")
    return True


