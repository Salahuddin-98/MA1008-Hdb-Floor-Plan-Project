# ==========================================
# 9. CLICK EVENT DISPATCHER
# ==========================================

def on_canvas_click(click_x, click_y):
    """Dispatches mouse click coordinates to individual button actions."""
    # Row 1: Walls, Scale, Clear, Exit (y: 318 to 352)
    if is_inside_box(click_x, click_y, -475, 318, 135, 34):
        handle_non_structural()
    elif is_inside_box(click_x, click_y, -330, 318, 135, 34):
        handle_structural()
    elif is_inside_box(click_x, click_y, -185, 318, 135, 34):
        handle_gable()
    elif is_inside_box(click_x, click_y, 50, 318, 110, 34):
        handle_set_scale()
    elif is_inside_box(click_x, click_y, 175, 318, 130, 34):
        handle_clear()
    elif is_inside_box(click_x, click_y, 320, 318, 130, 34):
        handle_exit()

    # Row 2: Doors, Windows, Save, Load (y: 276 to 310)
    elif is_inside_box(click_x, click_y, -475, 276, 135, 34):
        handle_swing_door()
    elif is_inside_box(click_x, click_y, -330, 276, 135, 34):
        handle_sliding_door()
    elif is_inside_box(click_x, click_y, -185, 276, 135, 34):
        handle_standard_window()
    elif is_inside_box(click_x, click_y, -40, 276, 135, 34):
        handle_sliding_window()
    elif is_inside_box(click_x, click_y, 175, 276, 130, 34):
        handle_save_plan()
    elif is_inside_box(click_x, click_y, 320, 276, 130, 34):
        handle_load_plan()

    # Row 3: Furniture Features (y: 234 to 268)
    elif is_inside_box(click_x, click_y, -475, 234, 135, 34):
        handle_bed()
    elif is_inside_box(click_x, click_y, -330, 234, 135, 34):
        handle_wardrobe()


# ==========================================
# 10. MAIN PROGRAM ENTRY
# ==========================================

def main():
    turtle.setup(1020, 780)
    turtle.title("HDB Floor Plan Designer - Walls, Openings & Furniture")
    turtle.speed(0)
    turtle.hideturtle()

    render_gui()
    render_canvas_frame()

    screen = turtle.Screen()
    screen.onscreenclick(on_canvas_click)

    turtle.done()


if __name__ == "__main__":
    main()
